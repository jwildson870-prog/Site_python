SECRET_KEY=gere-uma-chave-aleatoria-longa-e-secreta
DATABASE_URL=sqlite:///portal_python.db
ADMIN_NAME=Professor
ADMIN_EMAIL=professor@seu-dominio.com
ADMIN_PASSWORD=use-uma-senha-forte-e-unica
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
SESSION_COOKIE_SECURE=true

# Em Render com Persistent Disk, use o mesmo caminho do Mount Path do disco.
# Exemplo: /var/data/uploads
UPLOAD_FOLDER=/var/data/uploads

# Backblaze B2 (recomendado em produção para armazenamento permanente)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=SitePython
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Segurança em produção
# No Render, defina SECRET_KEY com um valor aleatório longo e mantenha FLASK_ENV=production.
# Não coloque credenciais reais neste arquivo.
FLASK_ENV=production

# E-mail transacional (recuperação de senha e confirmação de e-mail).
# Sem MAIL_SERVER configurado, esses recursos ficam com a estrutura pronta
# mas não enviam e-mail de verdade — o cadastro e o login continuam
# funcionando normalmente. Qualquer provedor SMTP padrão serve (SendGrid,
# Mailgun, Amazon SES, Gmail com senha de app, etc.).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@seu-dominio.com

# Anthropic (Tutor de IA)
ANTHROPIC_API_KEY=
